// Nexora Academy — Centralized Management Portal
// Single relational database (SRS §20). PostgreSQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Administration ─────────────────────────────

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  @@map("settings")
}

model Sequence {
  name   String @id
  prefix String @default("")
  next   Int    @default(1)
  @@map("sequences")
}

model Branch {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  address   String?
  isActive  Boolean  @default(true)
  users     User[]
  createdAt DateTime @default(now())
  @@map("branches")
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  headId    String?
  isActive  Boolean  @default(true)
  users     User[]   @relation("DeptUsers")
  createdAt DateTime @default(now())
  @@map("departments")
}

model Role {
  id          String     @id @default(cuid())
  key         String     @unique
  name        String
  description String?
  permissions String[]
  isSystem    Boolean    @default(false)
  users       UserRole[]
  createdAt   DateTime   @default(now())
  @@map("roles")
}

model User {
  id                 String          @id @default(cuid())
  email              String          @unique
  username           String          @unique
  name               String
  phone              String?
  passwordHash       String
  isActive           Boolean         @default(true)
  mustChangePassword Boolean         @default(false)
  designation        String?
  joiningDate        DateTime?
  extraPermissions   String[]        @default([])
  departmentId       String?
  department         Department?     @relation("DeptUsers", fields: [departmentId], references: [id])
  branchId           String?
  branch             Branch?         @relation(fields: [branchId], references: [id])
  lastLoginAt        DateTime?
  failedLogins       Int             @default(0)
  lockedUntil        DateTime?
  roles              UserRole[]
  authVersion        Int             @default(1)
  passwordChangedAt  DateTime?
  sessions           Session[]
  mfaFactor          MfaFactor?
  faculty            FacultyProfile?
  student            Student?        @relation("StudentUser")
  ownedLeads         Lead[]          @relation("LeadOwner")
  notifications      Notification[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  @@map("users")
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id])
  @@id([userId, roleId])
  @@map("user_roles")
}

/// Server-side session (SEC-05). One row per refresh-token generation; rotation creates a new row in the same family.
model Session {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId      String
  refreshHash   String    @unique
  mfaVerified   Boolean   @default(false)
  ip            String?
  userAgent     String?
  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?
  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}

/// TOTP authenticator factor (SEC-06). Secret is AES-256-GCM encrypted.
model MfaFactor {
  id           String    @id @default(cuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secretEnc    String
  confirmedAt  DateTime?
  lastUsedStep Int       @default(0)
  createdAt    DateTime  @default(now())
  @@map("mfa_factors")
}

model MfaRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  @@index([userId])
  @@map("mfa_recovery_codes")
}

/// Single-use second-step challenge issued after a correct password (5 minutes).
model MfaChallenge {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  portal    String?
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  @@map("mfa_challenges")
}

/// Last password hashes, for the reuse rule (SEC-04).
model PasswordHistory {
  id        String   @id @default(cuid())
  userId    String
  hash      String
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
  @@map("password_history")
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  /// RESET (forgot password) or ENROLL (first-time account activation)
  purpose   String    @default("RESET")
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  @@map("password_resets")
}

/// Generic master data: lead_source, lost_reason, qualification, document_type,
/// payment_mode, city, discount_reason (ADM-07). Deactivated, never deleted.
model MasterItem {
  id        String   @id @default(cuid())
  type      String
  code      String
  label     String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  meta      Json?
  createdAt DateTime @default(now())
  @@unique([type, code])
  @@index([type])
  @@map("master_items")
}

// ───────────────────────────── Academics ─────────────────────────────

model Course {
  id                  String         @id @default(cuid())
  code                String         @unique
  name                String
  slug                String         @unique
  category            String?
  summary             String?
  description         String?
  durationMonths      Int            @default(6)
  eligibility         String?
  mode                String         @default("Classroom")
  imageUrl            String?
  highlights          String[]       @default([])
  defaultInstallments Int            @default(1)
  isPublic            Boolean        @default(true)
  isActive            Boolean        @default(true)
  subjects            Subject[]
  batches             Batch[]
  feeComponents       FeeComponent[]
  leads               Lead[]
  students            Student[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  @@map("courses")
}

model Subject {
  id       String   @id @default(cuid())
  courseId String
  course   Course   @relation(fields: [courseId], references: [id])
  code     String
  name     String
  sequence Int      @default(1)
  hours    Int      @default(0)
  credits  Int?
  isActive Boolean  @default(true)
  modules  Module[]
  @@unique([courseId, code])
  @@map("subjects")
}

model Module {
  id        String  @id @default(cuid())
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])
  name      String
  sequence  Int     @default(1)
  hours     Int     @default(0)
  isActive  Boolean @default(true)
  completed Boolean @default(false)
  @@map("modules")
}

model Batch {
  id         String             @id @default(cuid())
  code       String             @unique
  name       String
  courseId   String
  course     Course             @relation(fields: [courseId], references: [id])
  startDate  DateTime
  endDate    DateTime?
  timing     String?
  capacity   Int                @default(30)
  mode       String             @default("Classroom")
  status     BatchStatus        @default(PLANNED)
  students   Student[]
  sessions   TimetableSession[]
  allocations FacultyAllocation[]
  createdAt  DateTime           @default(now())
  @@index([courseId])
  @@map("batches")
}

enum BatchStatus {
  PLANNED
  RUNNING
  COMPLETED
  CANCELLED
}

model FacultyProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id])
  qualifications String?
  subjects       String[] @default([])
  availability   Json?
  @@map("faculty_profiles")
}

model FacultyAllocation {
  id        String  @id @default(cuid())
  batchId   String
  batch     Batch   @relation(fields: [batchId], references: [id])
  subjectId String
  facultyId String
  @@unique([batchId, subjectId, facultyId])
  @@map("faculty_allocations")
}

model TimetableSession {
  id         String       @id @default(cuid())
  batchId    String
  batch      Batch        @relation(fields: [batchId], references: [id])
  subjectId  String?
  facultyId  String?
  title      String?
  startsAt   DateTime
  endsAt     DateTime
  room       String?
  published  Boolean      @default(false)
  cancelled  Boolean      @default(false)
  attendance Attendance[]
  createdAt  DateTime     @default(now())
  @@index([batchId, startsAt])
  @@index([facultyId, startsAt])
  @@map("timetable_sessions")
}

model Attendance {
  id         String           @id @default(cuid())
  sessionId  String
  session    TimetableSession @relation(fields: [sessionId], references: [id])
  studentId  String
  student    Student          @relation(fields: [studentId], references: [id])
  status     AttendanceStatus
  markedById String
  markedAt   DateTime         @default(now())
  @@unique([sessionId, studentId])
  @@index([studentId])
  @@map("attendance")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model Material {
  id           String   @id @default(cuid())
  batchId      String?
  courseId     String
  subjectId    String?
  title        String
  type         String   @default("LINK")
  url          String
  uploadedById String
  createdAt    DateTime @default(now())
  @@map("materials")
}

model Assignment {
  id          String       @id @default(cuid())
  batchId     String
  subjectId   String?
  title       String
  description String?
  dueAt       DateTime
  maxMarks    Int          @default(100)
  createdById String
  submissions Submission[]
  createdAt   DateTime     @default(now())
  @@map("assignments")
}

model Submission {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  studentId    String
  content      String?
  fileUrl      String?
  submittedAt  DateTime   @default(now())
  late         Boolean    @default(false)
  marks        Float?
  feedback     String?
  @@unique([assignmentId, studentId])
  @@map("submissions")
}

// ───────────────────────────── CRM ─────────────────────────────

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  COUNSELLED
  APPLICATION
  ADMITTED
  NOT_INTERESTED
  LOST
  JUNK
}

model Lead {
  id                     String               @id @default(cuid())
  code                   String               @unique
  name                   String
  phone                  String
  phoneNormalized        String
  email                  String?
  emailNormalized        String?
  courseId               String?
  course                 Course?              @relation(fields: [courseId], references: [id])
  source                 String               @default("walk_in")
  status                 LeadStatus           @default(NEW)
  closeReason            String?
  ownerId                String?
  owner                  User?                @relation("LeadOwner", fields: [ownerId], references: [id])
  city                   String?
  notes                  String?
  lastActivityAt         DateTime             @default(now())
  nextFollowUpAt         DateTime?
  chatwootContactId      Int?
  chatwootConversationId Int?
  studentId              String?              @unique
  student                Student?             @relation(fields: [studentId], references: [id])
  activities             LeadActivity[]
  followUps              FollowUp[]
  counselling            CounsellingSession[]
  applications           Application[]
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  @@index([phoneNormalized])
  @@index([emailNormalized])
  @@index([ownerId, status])
  @@index([status])
  @@map("leads")
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id])
  type      String // CALL, EMAIL, SMS, WHATSAPP, MEETING, NOTE, STATUS, ASSIGNMENT, SYSTEM
  direction String? // INBOUND / OUTBOUND
  content   String?
  outcome   String?
  nextStep  String?
  userId    String?
  meta      Json?
  createdAt DateTime @default(now())
  @@index([leadId, createdAt])
  @@map("lead_activities")
}

model FollowUp {
  id          String    @id @default(cuid())
  leadId      String
  lead        Lead      @relation(fields: [leadId], references: [id])
  dueAt       DateTime
  mode        String    @default("CALL")
  note        String?
  status      String    @default("PENDING") // PENDING, DONE, CANCELLED
  userId      String
  completedAt DateTime?
  reminded    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  @@index([userId, status, dueAt])
  @@map("follow_ups")
}

model CounsellingSession {
  id             String   @id @default(cuid())
  leadId         String
  lead           Lead     @relation(fields: [leadId], references: [id])
  counselorId    String
  date           DateTime @default(now())
  courseAdvised  String?
  remarks        String?
  outcome        String?
  createdAt      DateTime @default(now())
  @@map("counselling_sessions")
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ADMITTED
}

model Application {
  id        String            @id @default(cuid())
  code      String            @unique
  leadId    String?
  lead      Lead?             @relation(fields: [leadId], references: [id])
  courseId  String
  batchId   String?
  data      Json
  status    ApplicationStatus @default(SUBMITTED)
  remarks   String?
  studentId String?
  source    String            @default("staff")
  documents Document[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  @@map("applications")
}

// ───────────────────────────── Students ─────────────────────────────

enum StudentStatus {
  APPLIED
  ADMITTED
  ACTIVE
  ON_HOLD
  COMPLETED
  WITHDRAWN
  TERMINATED
}

model Student {
  id              String           @id @default(cuid())
  studentCode     String           @unique
  userId          String?          @unique
  user            User?            @relation("StudentUser", fields: [userId], references: [id])
  fullName        String
  dob             DateTime
  gender          String
  phone           String
  phoneNormalized String           @unique
  email           String
  emailNormalized String           @unique
  address         String
  city            String?
  photoUrl        String?
  status          StudentStatus    @default(ADMITTED)
  courseId        String
  course          Course           @relation(fields: [courseId], references: [id])
  batchId         String?
  batch           Batch?           @relation(fields: [batchId], references: [id])
  admissionDate   DateTime         @default(now())
  chatwootContactId Int?
  lead            Lead?
  guardians       Guardian[]
  education       Education[]
  documents       Document[]
  history         StudentHistory[]
  feePlans        FeePlan[]
  payments        Payment[]
  attendance      Attendance[]
  attempts        ExamAttempt[]
  results         Result[]
  certificates    Certificate[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  @@index([courseId, batchId, status])
  @@map("students")
}

model Guardian {
  id         String  @id @default(cuid())
  studentId  String
  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name       String
  relation   String
  phone      String
  email      String?
  occupation String?
  @@map("guardians")
}

model Education {
  id          String  @id @default(cuid())
  studentId   String
  student     Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  level       String
  institution String
  board       String?
  year        Int?
  marks       String?
  @@map("education")
}

model Document {
  id            String       @id @default(cuid())
  studentId     String?
  student       Student?     @relation(fields: [studentId], references: [id])
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id])
  type          String
  fileName      String
  storagePath   String
  mimeType      String
  size          Int
  status        String       @default("PENDING") // PENDING, VERIFIED, REJECTED
  verifiedById  String?
  verifiedAt    DateTime?
  remarks       String?
  createdAt     DateTime     @default(now())
  @@map("documents")
}

model StudentHistory {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  type      String
  message   String
  data      Json?
  userId    String?
  createdAt DateTime @default(now())
  @@index([studentId, createdAt])
  @@map("student_history")
}

// ───────────────────────────── Finance ─────────────────────────────

model FeeComponent {
  id            String   @id @default(cuid())
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id])
  name          String
  amount        Decimal  @db.Decimal(12, 2)
  taxPercent    Decimal  @default(0) @db.Decimal(5, 2)
  effectiveFrom DateTime @default(now())
  isActive      Boolean  @default(true)
  @@map("fee_components")
}

model FeePlan {
  id           String        @id @default(cuid())
  studentId    String
  student      Student       @relation(fields: [studentId], references: [id])
  courseId     String
  grossAmount  Decimal       @db.Decimal(12, 2)
  discount     Decimal       @default(0) @db.Decimal(12, 2)
  components   Json
  /// Due-date policy used when the plan was generated: anchor day-of-month (clamped to month end) and the
  /// academy time zone. NULL = plan created before the policy existed (its due dates are kept unchanged).
  dueAnchorDay Int?
  dueTimeZone  String?
  installments Installment[]
  createdAt    DateTime      @default(now())
  @@map("fee_plans")
}

model Installment {
  id         String              @id @default(cuid())
  feePlanId  String
  feePlan    FeePlan             @relation(fields: [feePlanId], references: [id])
  seq        Int
  amount     Decimal             @db.Decimal(12, 2)
  paidAmount Decimal             @default(0) @db.Decimal(12, 2)
  dueDate    DateTime
  status     String              @default("DUE") // DUE, PARTIAL, PAID
  lastReminderAt DateTime?
  allocations PaymentAllocation[]
  @@index([dueDate, status])
  @@map("installments")
}

model Invoice {
  id            String   @id @default(cuid())
  number        String   @unique
  studentId     String
  feePlanId     String
  installmentId String?
  amount        Decimal  @db.Decimal(12, 2)
  issuedAt      DateTime @default(now())
  dueDate       DateTime?
  status        String   @default("ISSUED")
  @@map("invoices")
}

model Payment {
  id             String              @id @default(cuid())
  receiptNumber  String              @unique
  studentId      String
  student        Student             @relation(fields: [studentId], references: [id])
  amount         Decimal             @db.Decimal(12, 2)
  mode           String
  reference      String?
  payer          String?
  paidAt         DateTime            @default(now())
  status         String              @default("POSTED") // POSTED, CANCEL_REQUESTED, CANCELLED
  recordedById   String?
  idempotencyKey String?             @unique
  gatewayRef     String?             @unique
  allocations    PaymentAllocation[]
  createdAt      DateTime            @default(now())
  @@index([paidAt])
  @@map("payments")
}

model PaymentAllocation {
  id            String      @id @default(cuid())
  paymentId     String
  payment       Payment     @relation(fields: [paymentId], references: [id])
  installmentId String
  installment   Installment @relation(fields: [installmentId], references: [id])
  amount        Decimal     @db.Decimal(12, 2)
  @@map("payment_allocations")
}

/// Immutable financial ledger (FIN-13). Update/Delete blocked by DB trigger.
model LedgerEntry {
  id        String   @id @default(cuid())
  studentId String
  type      String // FEE, PAYMENT, DISCOUNT, SCHOLARSHIP, REFUND, REVERSAL
  debit     Decimal  @default(0) @db.Decimal(12, 2)
  credit    Decimal  @default(0) @db.Decimal(12, 2)
  refType   String?
  refId     String?
  narration String
  userId    String?
  createdAt DateTime @default(now())
  @@index([studentId, createdAt])
  @@map("ledger_entries")
}

model Refund {
  id          String    @id @default(cuid())
  studentId   String
  amount      Decimal   @db.Decimal(12, 2)
  reason      String
  status      String    @default("PENDING_APPROVAL") // PENDING_APPROVAL, APPROVED, PAID, REJECTED
  reference   String?
  paidAt      DateTime?
  requestedById String
  createdAt   DateTime  @default(now())
  @@map("refunds")
}

model Discount {
  id        String   @id @default(cuid())
  studentId String
  feePlanId String
  kind      String // FIXED, PERCENT, SCHOLARSHIP
  value     Decimal  @db.Decimal(12, 2)
  amount    Decimal  @db.Decimal(12, 2)
  reason    String
  status    String   @default("PENDING_APPROVAL")
  requestedById String
  createdAt DateTime @default(now())
  @@map("discounts")
}

// ───────────────────────────── Examination ─────────────────────────────

model Question {
  id            String   @id @default(cuid())
  courseId      String
  subjectId     String?
  topic         String?
  difficulty    String   @default("MEDIUM")
  type          String // MCQ_SINGLE, MCQ_MULTI, TRUE_FALSE, SHORT, LONG
  text          String
  options       Json?
  correct       Json?
  marks         Float    @default(1)
  negativeMarks Float    @default(0)
  status        String   @default("ACTIVE") // ACTIVE, RETIRED
  createdAt     DateTime @default(now())
  exams         ExamQuestion[]
  @@index([courseId, subjectId])
  @@map("questions")
}

model Exam {
  id            String           @id @default(cuid())
  code          String           @unique
  title         String
  courseId      String
  batchId       String?
  subjectId     String?
  type          String           @default("MODULE_TEST")
  mode          String           @default("ONLINE")
  startAt       DateTime
  endAt         DateTime
  durationMin   Int              @default(60)
  totalMarks    Float            @default(100)
  passMarks     Float            @default(40)
  weightage     Float            @default(100)
  instructions  String?
  attemptLimit  Int              @default(1)
  shuffle       Boolean          @default(true)
  status        String           @default("DRAFT") // DRAFT, SCHEDULED, COMPLETED
  resultsPublished Boolean       @default(false)
  questions     ExamQuestion[]
  assignments   ExamAssignment[]
  attempts      ExamAttempt[]
  results       Result[]
  createdAt     DateTime         @default(now())
  @@map("exams")
}

model ExamQuestion {
  id         String   @id @default(cuid())
  examId     String
  exam       Exam     @relation(fields: [examId], references: [id])
  questionId String
  question   Question @relation(fields: [questionId], references: [id])
  order      Int
  @@unique([examId, questionId])
  @@map("exam_questions")
}

model ExamAssignment {
  id        String @id @default(cuid())
  examId    String
  exam      Exam   @relation(fields: [examId], references: [id])
  studentId String
  @@unique([examId, studentId])
  @@map("exam_assignments")
}

model ExamAttempt {
  id           String    @id @default(cuid())
  examId       String
  exam         Exam      @relation(fields: [examId], references: [id])
  studentId    String
  student      Student   @relation(fields: [studentId], references: [id])
  startedAt    DateTime  @default(now())
  submittedAt  DateTime?
  ip           String?
  questionOrder Json
  answers      Json      @default("{}")
  autoScore    Float?
  manualScore  Float?
  manualMarks  Json?
  status       String    @default("IN_PROGRESS") // IN_PROGRESS, SUBMITTED, EVALUATED
  tabSwitches  Int       @default(0)
  @@index([examId, studentId])
  @@map("exam_attempts")
}

model Result {
  id         String   @id @default(cuid())
  examId     String
  exam       Exam     @relation(fields: [examId], references: [id])
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id])
  marks      Float
  percentage Float
  grade      String
  passed     Boolean
  locked     Boolean  @default(false)
  remarks    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@unique([examId, studentId])
  @@map("results")
}

model Certificate {
  id               String   @id @default(cuid())
  number           String   @unique
  studentId        String
  student          Student  @relation(fields: [studentId], references: [id])
  courseId         String
  verificationCode String   @unique
  status           String   @default("PENDING_APPROVAL") // PENDING_APPROVAL, ISSUED, REVOKED
  issuedAt         DateTime?
  createdAt        DateTime @default(now())
  @@map("certificates")
}

// ───────────────────────────── Approvals ─────────────────────────────

model ApprovalWorkflow {
  id       String  @id @default(cuid())
  type     String  @unique
  name     String
  /// [{ level: 1, role: "finance_manager", minAmount?: number }]
  levels   Json
  isActive Boolean @default(true)
  @@map("approval_workflows")
}

model ApprovalRequest {
  id            String           @id @default(cuid())
  type          String
  entityType    String
  entityId      String
  title         String
  payload       Json
  amount        Decimal?         @db.Decimal(12, 2)
  status        String           @default("PENDING") // PENDING, APPROVED, REJECTED, RETURNED
  currentLevel  Int              @default(1)
  levels        Json
  requestedById String
  actions       ApprovalAction[]
  createdAt     DateTime         @default(now())
  decidedAt     DateTime?
  @@index([status, type])
  @@map("approval_requests")
}

model ApprovalAction {
  id        String          @id @default(cuid())
  requestId String
  request   ApprovalRequest @relation(fields: [requestId], references: [id])
  level     Int
  action    String // APPROVE, REJECT, RETURN
  comment   String?
  userId    String
  ip        String?
  userAgent String?
  createdAt DateTime        @default(now())
  @@map("approval_actions")
}

// ───────────────────────────── Notifications ─────────────────────────────

model NotificationTemplate {
  id             String   @id @default(cuid())
  key            String   @unique
  name           String
  subject        String?
  body           String
  /// Approved WhatsApp template name (for messages outside the 24h window)
  waTemplateName String?
  waLanguage     String   @default("en")
  waCategory     String   @default("UTILITY")
  channels       String[] @default(["IN_APP", "EMAIL", "WHATSAPP"])
  version        Int      @default(1)
  isActive       Boolean  @default(true)
  updatedAt      DateTime @updatedAt
  @@map("notification_templates")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  @@index([userId, readAt])
  @@map("notifications")
}

model NotificationLog {
  id          String   @id @default(cuid())
  channel     String
  recipient   String
  templateKey String?
  body        String
  status      String // QUEUED, SENT, DELIVERED, READ, FAILED, SKIPPED
  error       String?
  providerRef String?
  attempts    Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([providerRef])
  @@map("notification_logs")
}

// ───────────────────────────── Audit & Logs ─────────────────────────────

/// Append-only (FR-AUD-02). Update/Delete blocked by DB trigger.
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldValues Json?
  newValues Json?
  ip        String?
  userAgent String?
  requestId String?
  createdAt DateTime @default(now())
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model LoginLog {
  id        String   @id @default(cuid())
  userId    String?
  /// LOGIN_OK, LOGIN_FAIL, LOCKED, LOGOUT, MFA_OK, MFA_FAIL, MFA_ENROLLED, MFA_RESET, PASSWORD_CHANGE, PASSWORD_RESET, SESSION_REVOKED, TOKEN_REUSE
  event     String   @default("LOGIN")
  identifier String
  success   Boolean
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  @@map("login_logs")
}

model IntegrationLog {
  id         String   @id @default(cuid())
  name       String
  method     String
  endpoint   String
  status     Int?
  durationMs Int
  error      String?
  createdAt  DateTime @default(now())
  @@index([name, createdAt])
  @@map("integration_logs")
}
