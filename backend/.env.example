# ── Core ──
NODE_ENV=development
# development | test | staging | production — staging/production enable strict startup checks
APP_ENV=development
PORT=4000
DATABASE_URL=postgresql://nexora:nexora@localhost:5432/nexora?schema=public
PUBLIC_APP_URL=http://localhost:5173          # public website / portal URL (https://nexoraed.com)
API_BASE_URL=http://localhost:4000            # public URL of this API (used for webhook URLs)
CORS_ORIGINS=http://localhost:5173

# ── Security ── generate each value with: openssl rand -hex 32
# Leave empty in development (insecure dev defaults are used). Staging/production refuse to start without strong values.
JWT_SECRET=
APP_ENCRYPTION_KEY=
ACCESS_TOKEN_TTL_SEC=600
SESSION_MAX_HOURS=12
# Shared secret with the Cloudflare Worker proxy (required in staging/production unless REQUIRE_PROXY_SECRET=false)
PROXY_SECRET=
# REQUIRE_PROXY_SECRET=true
# Comma-separated production DB hosts that non-production environments must never use
PRODUCTION_DB_HOSTS=

# ── WhatsApp via Chatwoot (app.aiingo.com) ──
# These can also be set (and are stored encrypted) from Staff → Settings → WhatsApp.
CHATWOOT_BASE_URL=https://app.aiingo.com
CHATWOOT_ACCOUNT_ID=
CHATWOOT_INBOX_ID=
CHATWOOT_API_TOKEN=
CHATWOOT_WEBHOOK_SECRET=

# ── Email (optional) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Nexora Academy <no-reply@nexoraed.com>"

# ── Other integrations ──
WEBSITE_LEADS_API_KEY=
PAYMENT_WEBHOOK_SECRET=
ACADEMY_UPI_ID=
ACADEMY_BANK_DETAILS=

# ── Files & jobs ──
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
JOBS_ENABLED=true
# No default accounts are created. First Super Administrator: npm run admin:bootstrap -- --email … --name … --username …
# Demo data (development/test/staging only): APP_ENV=development npm run db:seed:demo
