# ── Required ──
POSTGRES_PASSWORD=change-me-strong
CLOUDFLARE_TUNNEL_TOKEN=
# openssl rand -hex 32
JWT_SECRET=
# openssl rand -hex 32 — keep safe: it encrypts the Chatwoot token in the database
APP_ENCRYPTION_KEY=
# openssl rand -hex 24 — same value as the Worker secret PROXY_SECRET
PROXY_SECRET=
# initial password for the "admin" user
SEED_ADMIN_PASSWORD=
SEED_DEMO=false

# ── URLs (site and API share the nexoraed.com origin via the Cloudflare Worker proxy) ──
PUBLIC_APP_URL=https://nexoraed.com
API_BASE_URL=https://nexoraed.com
CORS_ORIGINS=https://nexoraed.com,https://www.nexoraed.com
TRUST_PROXY=1

# ── WhatsApp via Chatwoot (can also be set later in Settings → WhatsApp) ──
CHATWOOT_BASE_URL=https://app.aiingo.com
CHATWOOT_ACCOUNT_ID=
CHATWOOT_INBOX_ID=
CHATWOOT_API_TOKEN=
CHATWOOT_WEBHOOK_SECRET=

# ── Optional ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Nexora Academy <no-reply@nexoraed.com>"
WEBSITE_LEADS_API_KEY=
PAYMENT_WEBHOOK_SECRET=
ACADEMY_UPI_ID=
ACADEMY_BANK_DETAILS=
